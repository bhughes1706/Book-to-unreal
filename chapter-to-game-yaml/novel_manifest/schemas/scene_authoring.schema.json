{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/scene_authoring.schema.json",
  "title": "Novel Game Scene Authoring Document",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "chapter_id",
    "scene_id",
    "title",
    "status",
    "presentation",
    "player_goal",
    "source",
    "dialogue",
    "story_changes",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "kind": {"const": "scene_authoring"},
    "chapter_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "title": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["draft", "needs_author_review", "approved", "locked"]
    },
    "presentation": {"$ref": "#/$defs/presentation"},
    "player_goal": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["excerpt"],
      "properties": {
        "excerpt": {"type": "string", "minLength": 1}
      }
    },
    "dialogue": {
      "type": "array",
      "items": {"$ref": "#/$defs/dialogue"}
    },
    "story_changes": {
      "type": "array",
      "items": {"$ref": "#/$defs/story_change"}
    },
    "staging": {"$ref": "#/$defs/staging"},
    "notes": {"type": "string"}
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "approval": {
      "enum": [
        "unreviewed",
        "approved",
        "rejected",
        "needs_discussion"
      ]
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "enum": ["scrolling_hd2d", "static_cinematic"]
        }
      }
    },
    "dialogue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "speaker",
        "text",
        "source_locked",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "speaker": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "source_locked": {"type": "boolean"},
        "approval": {"$ref": "#/$defs/approval"},
        "player_choice": {"$ref": "#/$defs/player_choice"}
      }
    },
    "player_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "prompt",
        "canonical_bounds",
        "approval",
        "options"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "prompt": {"type": "string", "minLength": 1},
        "canonical_bounds": {"type": "string", "minLength": 1},
        "approval": {"$ref": "#/$defs/approval"},
        "options": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/choice_option"}
        }
      }
    },
    "choice_option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "effect", "effect_scopes"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "effect": {"type": "string", "minLength": 1},
        "effect_scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "relationship",
              "self_definition",
              "public_perception",
              "resources",
              "scene_variation",
              "later_access"
            ]
          }
        }
      }
    },
    "staging": {
      "type": "object",
      "additionalProperties": false,
      "required": ["npcs", "interactables", "items", "hud_events", "beats"],
      "properties": {
        "npcs": {"type": "array", "items": {"$ref": "#/$defs/npc"}},
        "interactables": {
          "type": "array",
          "items": {"$ref": "#/$defs/interactable"}
        },
        "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
        "hud_events": {
          "type": "array",
          "items": {"$ref": "#/$defs/hud_event"}
        },
        "beats": {"type": "array", "items": {"$ref": "#/$defs/beat"}}
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "role",
        "presence",
        "behavior",
        "staging_notes",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "display_name": {"type": "string", "minLength": 1},
        "role": {"type": "string", "minLength": 1},
        "presence": {
          "enum": ["present_at_start", "enters_on_beat", "conditional"]
        },
        "behavior": {
          "enum": [
            "stationary",
            "idle",
            "follow_player",
            "follow_path",
            "scripted"
          ]
        },
        "entrance_beat_id": {"$ref": "#/$defs/id"},
        "exit_beat_id": {"$ref": "#/$defs/id"},
        "staging_notes": {"type": "string"},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "initial_state",
        "persistence",
        "interaction_prompt",
        "outcome",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "personal_item",
            "key_item",
            "consumable",
            "document"
          ]
        },
        "initial_state": {"enum": ["visible", "hidden", "held"]},
        "persistence": {"enum": ["scene", "chapter"]},
        "interaction_prompt": {"type": "string"},
        "outcome": {"type": "string", "minLength": 1},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "interactable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "kind",
        "interaction_prompt",
        "outcome",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": ["inspection", "prop", "transition", "traversal"]
        },
        "interaction_prompt": {"type": "string"},
        "outcome": {"type": "string", "minLength": 1},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "hud_event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "channel",
        "text",
        "trigger",
        "dismiss_mode",
        "duration_seconds",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "channel": {
          "enum": [
            "internal_observation",
            "message",
            "news",
            "translation",
            "system_notification",
            "objective",
            "item_reveal",
            "choice_consequence"
          ]
        },
        "text": {"type": "string", "minLength": 1},
        "trigger": {"type": "string", "minLength": 1},
        "dismiss_mode": {
          "enum": [
            "timed",
            "player_dismiss",
            "beat_advance",
            "persistent"
          ]
        },
        "duration_seconds": {"type": "number", "minimum": 0},
        "responses": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/hud_response"}
        },
        "event_thread": {"$ref": "#/$defs/event_thread"},
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "hud_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "outcome"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "label": {"type": "string", "minLength": 1},
        "outcome": {"type": "string", "minLength": 1},
        "set_flag": {"$ref": "#/$defs/id"}
      }
    },
    "event_thread": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {
          "enum": [
            "setup",
            "escalation",
            "callback",
            "choice",
            "consequence",
            "resolution",
            "reference"
          ]
        },
        "note": {"type": "string"}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "trigger",
        "optional",
        "actions",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "title": {"type": "string", "minLength": 1},
        "trigger": {"$ref": "#/$defs/beat_trigger"},
        "optional": {"type": "boolean"},
        "event_thread": {"$ref": "#/$defs/event_thread"},
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/beat_action"}
        },
        "approval": {"$ref": "#/$defs/approval"}
      }
    },
    "beat_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "begin_play",
            "interaction",
            "item_used",
            "dialogue_complete",
            "player_enters",
            "timer",
            "event",
            "beat_completed"
          ]
        },
        "target": {"type": "string", "minLength": 1}
      }
    },
    "beat_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "detail"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {
          "enum": [
            "show_hud",
            "spawn_npc",
            "move_npc",
            "give_item",
            "update_item",
            "update_interactable",
            "play_dialogue",
            "play_audio",
            "camera",
            "unlock_exit",
            "set_flag",
            "custom"
          ]
        },
        "target_id": {"$ref": "#/$defs/id"},
        "detail": {"type": "string", "minLength": 1}
      }
    },
    "story_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "canonical",
        "proposed",
        "rationale",
        "approval"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "type": {"type": "string", "minLength": 1},
        "canonical": {"type": "string", "minLength": 1},
        "proposed": {"type": "string", "minLength": 1},
        "rationale": {"type": "string", "minLength": 1},
        "approval": {"$ref": "#/$defs/approval"}
      }
    }
  }
}
