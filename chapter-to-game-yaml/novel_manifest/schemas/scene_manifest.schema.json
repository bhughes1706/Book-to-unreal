{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/scene_manifest.schema.json",
  "title": "Focused Novel Game Scene Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "chapter_id",
    "scene_id",
    "source_manifest",
    "status",
    "canonical_constraints",
    "approved_adaptation_decisions",
    "runtime",
    "acceptance_tests"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$"},
    "kind": {"const": "scene_manifest"},
    "chapter_id": {"$ref": "#/$defs/id"},
    "scene_id": {"$ref": "#/$defs/id"},
    "source_manifest": {"type": "string", "minLength": 1},
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_author_review",
        "approved_concept_pending_graybox",
        "graybox_in_progress",
        "graybox_approved",
        "production"
      ]
    },
    "canonical_constraints": {"$ref": "#/$defs/non_empty_strings"},
    "approved_adaptation_decisions": {"$ref": "#/$defs/non_empty_strings"},
    "design": {"$ref": "#/$defs/design"},
    "first_graybox_assets": {"$ref": "#/$defs/non_empty_strings"},
    "art_replacement_assets": {"$ref": "#/$defs/non_empty_strings"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "acceptance_tests": {"$ref": "#/$defs/non_empty_strings"}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "non_empty_strings": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "vector3": {
      "type": "array",
      "prefixItems": [
        {"type": "number"},
        {"type": "number"},
        {"type": "number"}
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engine": {"type": "string", "enum": ["unreal", "godot", "unity"]},
        "camera_note": {"type": "string"},
        "player_start_region": {"type": "string"},
        "boy_path_region": {"type": "string"},
        "gameplay_plane": {"type": "string"}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "camera", "player", "environment", "resources", "beats"],
      "properties": {
        "level": {"$ref": "#/$defs/level"},
        "camera": {"$ref": "#/$defs/camera"},
        "player": {"$ref": "#/$defs/player"},
        "environment": {"$ref": "#/$defs/environment"},
        "resources": {"$ref": "#/$defs/resources"},
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/beat"}
        }
      }
    },
    "level": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "output_path", "environment_kit_ids"],
      "properties": {
        "name": {"type": "string", "pattern": "^L_[A-Za-z0-9_]+$"},
        "output_path": {"type": "string", "pattern": "^/Game/.+"},
        "environment_kit_ids": {"type": "array", "items": {"$ref": "#/$defs/id"}}
      }
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "horizontal_tracking",
        "vertical_tracking",
        "wall_vertical_coverage_target",
        "sky_vertical_coverage_max"
      ],
      "properties": {
        "mode": {"enum": ["side_view_perspective", "orthographic"]},
        "alternate_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["side_view_perspective", "orthographic"]}
        },
        "horizontal_tracking": {"type": "boolean"},
        "vertical_tracking": {"type": "boolean"},
        "wall_vertical_coverage_target": {"type": "number", "minimum": 0, "maximum": 1},
        "sky_vertical_coverage_max": {"type": "number", "minimum": 0, "maximum": 1},
        "perspective_fov_degrees": {"type": "number", "exclusiveMinimum": 0, "maximum": 170},
        "orthographic_width_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "spawn_marker_id", "movement_mode", "abilities", "initial_input_delay_seconds"],
      "properties": {
        "character_id": {"$ref": "#/$defs/id"},
        "spawn_marker_id": {"$ref": "#/$defs/id"},
        "movement_mode": {"enum": ["horizontal", "free_2d", "disabled"]},
        "abilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["walk", "run", "inspect", "interact", "lens"]}
        },
        "initial_input_delay_seconds": {"type": "number", "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ocean_visible", "gameplay_lane_width_m", "wall", "beach"],
      "properties": {
        "ocean_visible": {"type": "boolean"},
        "gameplay_lane_width_m": {"type": "number", "exclusiveMinimum": 0},
        "wall": {"$ref": "#/$defs/geometry"},
        "beach": {"$ref": "#/$defs/geometry"}
      }
    },
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "placeholder_asset_id", "length_m", "width_m", "height_m"],
      "properties": {
        "resource_id": {"$ref": "#/$defs/id"},
        "placeholder_asset_id": {"$ref": "#/$defs/id"},
        "length_m": {"type": "number", "exclusiveMinimum": 0},
        "width_m": {"type": "number", "exclusiveMinimum": 0},
        "height_m": {"type": "number", "exclusiveMinimum": 0},
        "material_id": {"$ref": "#/$defs/id"}
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["markers", "actors", "paths", "interactables", "lens_content", "audio"],
      "properties": {
        "markers": {"type": "array", "items": {"$ref": "#/$defs/marker"}},
        "actors": {"type": "array", "items": {"$ref": "#/$defs/actor"}},
        "paths": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "interactables": {"type": "array", "items": {"$ref": "#/$defs/interactable"}},
        "lens_content": {"type": "array", "items": {"$ref": "#/$defs/lens_content"}},
        "audio": {"type": "array", "items": {"$ref": "#/$defs/audio"}}
      }
    },
    "marker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "location_m"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["player_start", "actor_spawn", "trigger", "transition"]},
        "location_m": {"$ref": "#/$defs/vector3"},
        "radius_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "character_id", "spawn_marker_id", "placeholder_asset_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "character_id": {"$ref": "#/$defs/id"},
        "spawn_marker_id": {"$ref": "#/$defs/id"},
        "placeholder_asset_id": {"$ref": "#/$defs/id"}
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "points_m"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "points_m": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/vector3"}}
      }
    },
    "interactable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "marker_id", "prompt"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "marker_id": {"$ref": "#/$defs/id"},
        "prompt": {"type": "string", "minLength": 1}
      }
    },
    "lens_content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "channel", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "channel": {"enum": ["internal_observation", "mail", "message", "news", "translation", "credits", "system_notification"]},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "loop"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["ambience", "music", "event", "voice"]},
        "loop": {"type": "boolean"},
        "placeholder_asset_id": {"$ref": "#/$defs/id"}
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trigger", "actions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "once": {"type": "boolean", "default": true},
        "trigger": {"$ref": "#/$defs/trigger"},
        "actions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/action"}}
      }
    },
    "trigger": {
      "oneOf": [
        {"$ref": "#/$defs/trigger_begin_play"},
        {"$ref": "#/$defs/trigger_interaction"},
        {"$ref": "#/$defs/trigger_player_distance"},
        {"$ref": "#/$defs/trigger_beat_completed"},
        {"$ref": "#/$defs/trigger_elapsed_since_beat"},
        {"$ref": "#/$defs/trigger_event"},
        {"$ref": "#/$defs/trigger_group"}
      ]
    },
    "trigger_begin_play": {
      "type": "object", "additionalProperties": false,
      "required": ["type"], "properties": {"type": {"const": "begin_play"}}
    },
    "trigger_interaction": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "target_id"],
      "properties": {"type": {"const": "interaction"}, "target_id": {"$ref": "#/$defs/id"}}
    },
    "trigger_player_distance": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "marker_id", "radius_m"],
      "properties": {
        "type": {"const": "player_distance"},
        "marker_id": {"$ref": "#/$defs/id"},
        "radius_m": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "trigger_beat_completed": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "beat_id"],
      "properties": {"type": {"const": "beat_completed"}, "beat_id": {"$ref": "#/$defs/id"}}
    },
    "trigger_elapsed_since_beat": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "beat_id", "seconds"],
      "properties": {
        "type": {"const": "elapsed_since_beat"},
        "beat_id": {"$ref": "#/$defs/id"},
        "seconds": {"type": "number", "minimum": 0}
      }
    },
    "trigger_event": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "event_id"],
      "properties": {"type": {"const": "event"}, "event_id": {"$ref": "#/$defs/id"}}
    },
    "trigger_group": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "conditions"],
      "properties": {
        "type": {"enum": ["any_of", "all_of"]},
        "conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/trigger"}}
      }
    },
    "action": {
      "oneOf": [
        {"$ref": "#/$defs/action_set_input"},
        {"$ref": "#/$defs/action_wait"},
        {"$ref": "#/$defs/action_lens"},
        {"$ref": "#/$defs/action_spawn"},
        {"$ref": "#/$defs/action_follow_path"},
        {"$ref": "#/$defs/action_audio"},
        {"$ref": "#/$defs/action_unlock_transition"}
      ]
    },
    "action_set_input": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "enabled"],
      "properties": {"type": {"const": "set_player_input"}, "enabled": {"type": "boolean"}}
    },
    "action_wait": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "seconds"],
      "properties": {"type": {"const": "wait"}, "seconds": {"type": "number", "minimum": 0}}
    },
    "action_lens": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "content_id"],
      "properties": {"type": {"const": "show_lens_content"}, "content_id": {"$ref": "#/$defs/id"}}
    },
    "action_spawn": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "actor_id"],
      "properties": {"type": {"const": "spawn_actor"}, "actor_id": {"$ref": "#/$defs/id"}}
    },
    "action_follow_path": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "actor_id", "path_id", "speed_mps", "destroy_on_complete", "completion_event_id"],
      "properties": {
        "type": {"const": "follow_path"},
        "actor_id": {"$ref": "#/$defs/id"},
        "path_id": {"$ref": "#/$defs/id"},
        "speed_mps": {"type": "number", "exclusiveMinimum": 0},
        "destroy_on_complete": {"type": "boolean"},
        "completion_event_id": {"$ref": "#/$defs/id"}
      }
    },
    "action_audio": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "audio_id"],
      "properties": {"type": {"const": "play_audio"}, "audio_id": {"$ref": "#/$defs/id"}}
    },
    "action_unlock_transition": {
      "type": "object", "additionalProperties": false,
      "required": ["type", "marker_id"],
      "properties": {"type": {"const": "unlock_transition"}, "marker_id": {"$ref": "#/$defs/id"}}
    }
  }
}
