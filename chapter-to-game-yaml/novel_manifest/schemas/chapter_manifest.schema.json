{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/chapter_manifest.schema.json",
  "title": "Novel Chapter Game Adaptation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "source",
    "chapter",
    "characters",
    "locations",
    "world_systems",
    "environment_kits",
    "scenes",
    "unresolved_questions"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "project": {
      "$ref": "#/$defs/project"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "chapter": {
      "$ref": "#/$defs/chapter"
    },
    "characters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/character"
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "world_systems": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/world_system"
      }
    },
    "environment_kits": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/environment_kit"
      }
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scene"
      }
    },
    "content_notes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/content_note"
      },
      "default": []
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/question"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "explicit",
        "strong_inference",
        "weak_inference",
        "proposal"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_id",
        "working_title",
        "target_format"
      ],
      "properties": {
        "project_id": {
          "type": "string"
        },
        "working_title": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_format": {
          "type": "string"
        },
        "engine": {
          "type": [
            "string",
            "null"
          ]
        },
        "camera_model": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "filename",
        "format",
        "word_count",
        "sha256"
      ],
      "properties": {
        "filename": {
          "type": "string"
        },
        "format": {
          "type": "string"
        },
        "word_count": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "extraction_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "number",
        "title",
        "point_of_view",
        "tense",
        "canonical_summary",
        "themes",
        "adaptation_summary"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "point_of_view": {
          "type": "string"
        },
        "tense": {
          "type": "string"
        },
        "canonical_summary": {
          "type": "string"
        },
        "themes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "adaptation_summary": {
          "type": "string"
        }
      }
    },
    "fact_group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facts",
        "confidence"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "$ref": "#/$defs/confidence"
        }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "chapter_role",
        "canonical",
        "first_scene_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string"
        },
        "chapter_role": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/fact_group"
        },
        "adaptation_notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "first_scene_id": {
          "$ref": "#/$defs/id"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "canonical",
        "kit_ids"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/fact_group"
        },
        "kit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "world_system": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "canonical",
        "introduced_scene_id"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string"
        },
        "canonical": {
          "$ref": "#/$defs/fact_group"
        },
        "introduced_scene_id": {
          "$ref": "#/$defs/id"
        },
        "gameplay_opportunities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "environment_kit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "purpose",
        "module_candidates"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        },
        "module_candidates": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reuse_scope": {
          "type": "string"
        }
      }
    },
    "source_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_anchor",
        "end_anchor"
      ],
      "properties": {
        "start_anchor": {
          "type": "string",
          "minLength": 4
        },
        "end_anchor": {
          "type": "string",
          "minLength": 4
        }
      }
    },
    "canonical_scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "narrative_function",
        "entry_state",
        "exit_state"
      ],
      "properties": {
        "events": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "narrative_function": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "entry_state": {
          "type": "string"
        },
        "exit_state": {
          "type": "string"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "canonical",
        "proposed",
        "rationale",
        "approval"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "canonical": {
          "type": "string"
        },
        "proposed": {
          "type": "string"
        },
        "rationale": {
          "type": "string"
        },
        "approval": {
          "type": "string",
          "enum": [
            "unreviewed",
            "approved_by_author",
            "rejected",
            "needs_discussion"
          ]
        }
      }
    },
    "beat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "trigger",
        "action",
        "player_experience"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "trigger": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "player_experience": {
          "type": "string"
        },
        "optional": {
          "type": "boolean",
          "default": false
        }
      }
    },
    "adaptation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "player_role",
        "player_goal",
        "camera",
        "gameplay_mode",
        "beats",
        "changes_from_source"
      ],
      "properties": {
        "player_role": {
          "type": "string"
        },
        "player_goal": {
          "type": "string"
        },
        "camera": {
          "type": "string"
        },
        "gameplay_mode": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "beats": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/beat"
          }
        },
        "interactions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "audio_direction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "visual_direction": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "transition_out": {
          "type": "string"
        },
        "changes_from_source": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        }
      }
    },
    "asset_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "display_name",
        "classification",
        "owner_tool",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "display_name": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "kit",
            "shared",
            "unique"
          ]
        },
        "owner_tool": {
          "type": "string",
          "enum": [
            "unreal",
            "blender",
            "2d_art",
            "audio",
            "writing",
            "mixed"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "placeholder",
            "planned",
            "in_progress",
            "approved",
            "blocked"
          ]
        }
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_kit_ids",
        "required_assets",
        "system_dependencies",
        "risks"
      ],
      "properties": {
        "environment_kit_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "required_assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/asset_requirement"
          }
        },
        "system_dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "risks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "scene": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "order",
        "title",
        "location_id",
        "time_context",
        "character_ids",
        "source_span",
        "canonical",
        "adaptation",
        "production"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "order": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string"
        },
        "location_id": {
          "$ref": "#/$defs/id"
        },
        "time_context": {
          "type": "string"
        },
        "character_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "world_system_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "source_span": {
          "$ref": "#/$defs/source_span"
        },
        "canonical": {
          "$ref": "#/$defs/canonical_scene"
        },
        "adaptation": {
          "$ref": "#/$defs/adaptation"
        },
        "production": {
          "$ref": "#/$defs/production"
        }
      }
    },
    "content_note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "description",
        "scene_ids"
      ],
      "properties": {
        "category": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "scene_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      }
    },
    "question": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "affects",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "question": {
          "type": "string"
        },
        "affects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "open",
            "answered",
            "deferred"
          ]
        },
        "answer": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}